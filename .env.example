# Copy to .env and adjust. NEVER commit a real .env file.

# HTTP server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MySQL database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=dentalistics

# Schema migrations directory (relative to repository root)
MIGRATIONS_DIR=./migrations

# Reverse proxy: set to true (or a hop count such as 1) when the app runs
# behind a reverse proxy (e.g. nginx), so rate limiting and logs see the
# real client IP instead of the proxy address. Leave unset otherwise.
# TRUST_PROXY=1

# Directory of the built frontend served by Express (default: frontend/dist).
# UI_DIST_DIR=./frontend/dist

# Automation scheduler tick interval in milliseconds (default: 60000).
# REMINDER_TICK_MS=60000

# Optional: set to a reachable test database to enable DB integration tests.
# When unset, DB integration tests are SKIPPED (reported, never faked).
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3306
# TEST_DB_USER=root
# TEST_DB_PASSWORD=changeme
# TEST_DB_NAME=dentalistics_test

# Bootstrap platform administrator (used by `npm run seed:admin`).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-long-random-password

# Password reset email delivery (forgot/reset password flow).
# The API always answers with a generic message; without these set,
# reset emails are NOT delivered and the server logs a warning instead.
# RESET_BASE_URL=https://app.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=smtp-user
# SMTP_PASS=smtp-password
# SMTP_FROM=Clinic <no-reply@example.com>
