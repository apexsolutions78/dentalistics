# Copy to .env and adjust. NEVER commit a real .env file.

# HTTP server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MySQL database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=dentalistics

# Schema migrations directory (relative to repository root)
MIGRATIONS_DIR=./migrations

# Optional: set to a reachable test database to enable DB integration tests.
# When unset, DB integration tests are SKIPPED (reported, never faked).
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3306
# TEST_DB_USER=root
# TEST_DB_PASSWORD=changeme
# TEST_DB_NAME=dentalistics_test
